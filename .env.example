# Concord IQ — stable configuration and placeholders only.
# Never put access tokens here. Cloud tokens are acquired at runtime by
# `make dev-foundry` / `make dev-fabric` / `make dev-work-iq` (see docs/cloud-runtime.md).

# Safe default
PROVIDER=local
CONCORD_WORKFLOW_MODE=strict
ALLOW_CLOUD=false
MAX_CLOUD_CALLS=0
LLM_PROVIDER=disabled

# Local data
DATABASE_URL=postgresql+psycopg://concord:concord-local-only@localhost:5432/concord_iq
DUCKDB_PATH=data/concord_iq.duckdb
REPLAY_ARTIFACT_PATH=artifacts/replay/sanitized/latest.json
CAPTURE_RAW_DIR=artifacts/replay/raw
CAPTURE_SANITIZED_PATH=artifacts/replay/sanitized/latest.json

# Foundry Agent Service / Microsoft Agent Framework hosted path (stable, non-secret)
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Foundry Agent Service (hosted runtime) — `make dev-foundry` acquires the token
FOUNDRY_HOSTED_ENDPOINT=
FOUNDRY_HOSTED_AGENT_ID=

# Fabric IQ — stable IDs/endpoint; `make dev-fabric` acquires the token
FABRIC_WORKSPACE_NAME=ConcordIQHackathon
FABRIC_LAKEHOUSE_NAME=ConcordIQLakehouse
FABRIC_ONTOLOGY_NAME=ConcordIQOntology
FABRIC_CAPACITY_ID=
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_ONTOLOGY_ID=
FABRIC_IQ_MCP_ENDPOINT=

# Foundry IQ (advisory authority grounding fallback)
FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_API_VERSION=2026-04-01

# Work IQ (Microsoft 365 Copilot Retrieval) — `make dev-work-iq` uses MSAL device-code
WORK_IQ_ENDPOINT=https://graph.microsoft.com/v1.0/copilot/retrieval
WORK_IQ_DATA_SOURCE=sharePoint
WORK_IQ_CLIENT_ID=
WORK_IQ_TENANT_ID=

# Optional local narration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Backward compatibility only — runtime token acquisition is preferred. Leave these
# blank. If set, they are honored but never logged; prefer the make targets above.
# FOUNDRY_ACCESS_TOKEN=
# FABRIC_IQ_ACCESS_TOKEN=
# WORK_IQ_ACCESS_TOKEN=
# FOUNDRY_IQ_ACCESS_TOKEN=
# FOUNDRY_IQ_API_KEY=
