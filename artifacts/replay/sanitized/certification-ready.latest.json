          "executed_sql": "SELECT l.learner_id AS entity_id, l.exam_voucher_cost AS metric_value FROM learners l JOIN manager_approvals ma ON ma.learner_id = l.learner_id AND ma.approved = 1 WHERE NOT EXISTS (SELECT 1 FROM required_labs rl WHERE rl.certification_id = l.certification_id AND rl.required = 1 AND NOT EXISTS (SELECT 1 FROM lab_completions lc WHERE lc.learner_id = l.learner_id AND lc.lab_id = rl.lab_id AND lc.completed = 1)) ORDER BY entity_id"
