# Files excluded from agent code deployment packaging.
# Uses .gitignore syntax.
# Note: only the root .agentignore is read; subdirectory files are not supported.
#
# To include a file that is excluded by default, use negation: !filename

# azd tooling files
agent.yaml
agent.manifest.yaml
azure.yaml
.agentignore

# Security / secrets
.env
.env.*
.azure/
.git/
.claude/
.codex/
.concord-dev/
.checkpoints/
.function_approvals/

# Python
__pycache__/
.venv/
venv/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# .NET
bin/
obj/
*.user
*.suo
.vs/

# Node
node_modules/
frontend/

# Local-only build, proof, and bulk Fabric loading material
tests/
docs/
infra/
scripts/
fabric_seed/learning_cli/
fabric_seed/learning_delta/
fabric_seed/ontology_backups/
artifacts/replay/raw/
artifacts/foundry/
